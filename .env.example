# Public NestJS origin. Do not include /api/v1 or private credentials.
# Required for all environments. There is no silent localhost fallback in code
# when you omit this in a deployed build — set it explicitly.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public site origin used for auth email redirect URLs (password reset).
# Required for password-reset emails. Use your deployed https origin in pilot/prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Auth public client settings. Set both, or neither.
# Never put the service-role key in NEXT_PUBLIC_* variables.
# Variable name must match code: NEXT_PUBLIC_SUPABASE_ANON_KEY (not PUBLISHABLE_KEY).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Must match the Nest API SIGNUP_INTENT_SECRET.
# Do not prefix this with NEXT_PUBLIC_.
# SIGNUP_INTENT_SECRET=

# Optional public legal identity. Leave unset until the operating organisation
# confirms them. Do not invent a company name, address, or inbox.
# NEXT_PUBLIC_LEGAL_NAME=
# NEXT_PUBLIC_LEGAL_ADDRESS=
# NEXT_PUBLIC_SUPPORT_EMAIL=
# NEXT_PUBLIC_GRIEVANCE_EMAIL=
